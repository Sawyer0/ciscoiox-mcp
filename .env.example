# Copy to .env (never commit .env). Set at least one integration.

# --- Lab reservation tools (Quali CloudShell Sandbox API in the DevNet portal) ---
QUALI_PORTAL_HOST=
# CloudShell Sandbox API port; 82 is the documented default.
QUALI_PORTAL_PORT=82
QUALI_DOMAIN=Global
QUALI_USER=
QUALI_PASS=
# Optional: pin a sandbox id instead of picking the first Ready one.
LAB_ID=

# --- IOx app tools (Cisco Application Framework REST API on the device) ---
IOX_HOST=
IOX_PORT=8443
# https (default) or http, depending on the device.
IOX_SCHEME=https
IOX_USER=
IOX_PASS=
# Sandbox devices use self-signed certificates; set true for a trusted cert.
IOX_TLS_VERIFY=false
