{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./dist",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src/**/*", "test/**/*", "vitest.config.ts"],
	"exclude": ["node_modules"]
}
