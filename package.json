{
	"name": "ciscoiox-mcp",
	"version": "0.1.0",
	"description": "MCP server for Cisco DevNet IOx sandboxes: lab reservation and IOx app lifecycle tools",
	"license": "Apache-2.0",
	"type": "module",
	"private": true,
	"bin": {
		"ciscoiox-mcp": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20.12"
	},
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"start:node": "node dist/index.js",
		"build": "tsup",
		"prepare": "tsup",
		"lint": "biome check --error-on-warnings .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"coverage": "vitest run --coverage --exclude 'test/e2e/**'",
		"test:e2e": "vitest run test/e2e",
		"test:e2e:node": "E2E_RUNTIME=node vitest run test/e2e"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.25.2",
		"axios": "^1.13.2",
		"dotenv": "^17.2.3",
		"yaml": "^2.9.1",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@types/bun": "1.3.5",
		"@vitest/coverage-v8": "4.0.16",
		"tsup": "8.5.1",
		"typescript": "5.9.3",
		"vitest": "4.0.16"
	}
}
